rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function superAdmin() { return signedIn() && request.auth.token.superAdmin == true; }
    function tenantDoc(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)); }
    function membership(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)); }
    function activeMember(tenantId) {
      return signedIn() && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && membership(tenantId).data.status == 'active';
    }
    function roleIn(tenantId, roles) { return activeMember(tenantId) && membership(tenantId).data.role in roles; }
    function subscriptionActive(tenantId) {
      return tenantDoc(tenantId).data.status == 'active'
        && tenantDoc(tenantId).data.subscription.status in ['trialing', 'active']
        && tenantDoc(tenantId).data.subscription.accessUntil > request.time;
    }
    function validTenantEntity(tenantId) {
      return request.resource.data.tenantId == tenantId && request.resource.data.tenantId == resource.data.tenantId;
    }
    function validNewTenantEntity(tenantId) { return request.resource.data.tenantId == tenantId; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || superAdmin());
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'activeTenantId', 'updatedAt']);
      allow delete: if false;
      match /memberships/{tenantId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.userId == uid && request.resource.data.tenantId == tenantId
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == uid;
        allow write: if superAdmin();
      }
    }

    match /tenants/{tenantId} {
      allow create: if signedIn() && request.resource.data.id == tenantId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.subscription.status == 'trialing'
        && request.resource.data.subscription.accessUntil is timestamp
        && request.resource.data.subscription.accessUntil > request.time
        && request.resource.data.subscription.accessUntil <= request.time + duration.value(14, 'd');
      allow read: if superAdmin() || activeMember(tenantId);
      allow update: if superAdmin() || (roleIn(tenantId, ['owner', 'admin'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branding', 'printer', 'updatedAt']));
      allow delete: if false;

      match /members/{uid} {
        allow read: if superAdmin() || activeMember(tenantId);
        allow create: if superAdmin() || roleIn(tenantId, ['owner', 'admin'])
          || (signedIn() && uid == request.auth.uid && request.resource.data.userId == uid
            && request.resource.data.tenantId == tenantId && request.resource.data.role == 'owner'
            && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == uid);
        allow update: if superAdmin() || (roleIn(tenantId, ['owner', 'admin'])
          && resource.data.role != 'owner' && request.resource.data.tenantId == tenantId);
        allow delete: if superAdmin() || (roleIn(tenantId, ['owner']) && resource.data.role != 'owner');
      }
      match /clients/{id} {
        allow read: if superAdmin() || activeMember(tenantId);
        allow create: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','appraiser','cashier']) && validNewTenantEntity(tenantId);
        allow update: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','appraiser','cashier']) && validTenantEntity(tenantId);
        allow delete: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin']);
      }
      match /loans/{id} {
        allow read: if superAdmin() || activeMember(tenantId);
        allow create: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','appraiser']) && validNewTenantEntity(tenantId);
        allow update: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','appraiser']) && validTenantEntity(tenantId);
        allow delete: if false;
      }
      match /articles/{id} {
        allow read: if superAdmin() || activeMember(tenantId);
        allow create: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','appraiser']) && validNewTenantEntity(tenantId);
        allow update: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','appraiser']) && validTenantEntity(tenantId);
        allow delete: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin']);
      }
      match /transactions/{id} {
        allow read: if superAdmin() || activeMember(tenantId);
        allow create: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','cashier']) && validNewTenantEntity(tenantId);
        allow update, delete: if false;
      }
      match /fixedExpenses/{id} {
        allow read: if superAdmin() || activeMember(tenantId);
        allow create, update: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin','cashier']);
        allow delete: if subscriptionActive(tenantId) && roleIn(tenantId, ['owner','admin']);
      }
      match /receipts/{id} { allow read: if superAdmin() || activeMember(tenantId); allow write: if false; }
      match /auditLogs/{id} { allow read: if superAdmin() || roleIn(tenantId, ['owner','admin']); allow write: if false; }
    }
    match /plans/{id} { allow read: if true; allow write: if superAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
