{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "tasador", "cajero"] },
        "permissions": {
          "type": "object",
          "properties": {
            "verHistorial": { "type": "boolean" },
            "modificarPrestamos": { "type": "boolean" },
            "modificarClientes": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "Customer information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone"]
    },
    "Article": {
      "title": "Article",
      "description": "Pawned item in inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "state": { "type": "string", "enum": ["en_resguardo", "devuelto", "vendido"] },
        "contractId": { "type": "string" },
        "clientId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "state"]
    },
    "Loan": {
      "title": "Loan Contract",
      "description": "Financial contract for a loan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["prenda", "sin_garantia", "hipotecario"] },
        "capital": { "type": "number" },
        "rate": { "type": "number" },
        "installments": { "type": "number" },
        "balance": { "type": "number" },
        "status": { "type": "string", "enum": ["activo", "atrasado", "vencido", "pagado"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "type", "capital", "rate", "status"]
    },
    "Transaction": {
      "title": "Cash Transaction",
      "description": "Record of income or expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractId": { "type": "string" },
        "type": { "type": "string", "enum": ["ingreso", "egreso"] },
        "amount": { "type": "number" },
        "previousBalance": { "type": "number" },
        "newBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "amount", "createdAt"]
    },
    "BusinessConfig": {
      "title": "Business Configuration",
      "description": "Global settings for the pawn shop",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "initialCapital": { "type": "number" },
        "notaryData": { "type": "string" }
      }
    },
    "FixedExpense": {
      "title": "Fixed Expense",
      "description": "Operational expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/usuarios/{uid}": { "schema": "User", "description": "User profiles" },
    "/clientes/{id}": { "schema": "Client", "description": "Customer database" },
    "/articulos/{id}": { "schema": "Article", "description": "Inventory of pawned items" },
    "/contratos_empeno/{id}": { "schema": "Loan", "description": "Loan contracts" },
    "/transacciones_caja/{id}": { "schema": "Transaction", "description": "Cash flow logs" },
    "/configuracion/perfil_negocio": { "schema": "BusinessConfig", "description": "Business settings" },
    "/gastos_fijos/{id}": { "schema": "FixedExpense", "description": "Operational costs" }
  }
}
